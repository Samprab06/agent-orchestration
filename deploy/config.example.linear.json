{
  "identity": {
    "human": "Sam",
    "agent": "Oracle"
  },
  "approvers": [
    "your-github-login"
  ],
  "github": {
    "auth": "token",
    "token_file": "~/.config/agentorch/github-token"
  },
  "linear": {
    "team": "ENG",
    "api_key_file": "~/.config/agentorch/linear-key",
    "board_issue": "ENG-1",
    "review_state": "In Review"
  },
  "agent": {
    "type": "banyancode",
    "command": "banyancode",
    "model": "opencode/beam-free",
    "timeout": 900
  },
  "subagents": {
    "oracle-backend": {
      "description": "APIs, database, server code",
      "instructions": "Own the backend.",
      "max_subagents": 4
    },
    "oracle-frontend": {
      "description": "UI pages and components",
      "instructions": "Own the frontend.",
      "max_subagents": 4
    }
  },
  "planner": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-6-luna",
    "api_key_file": "~/.config/agentorch/planner-key",
    "megadoc": "final/MEGADOC.md",
    "chunk_chars": 60000,
    "max_tickets": 40,
    "timeout": 300,
    "extra_agents": [
      "teammate-codex"
    ]
  },
  "sandbox": {
    "type": "bwrap"
  },
  "worker": {
    "state_dir": "~/.local/share/agentorch",
    "poll": 30,
    "max_parallel": 4
  },
  "notify": [
    {
      "type": "telegram",
      "env_file": "~/.hermes/.env"
    }
  ],
  "repositories": [
    {
      "repository": "your-org/your-project",
      "branch": "main",
      "verify": [
        "npm",
        "test"
      ]
    }
  ]
}
